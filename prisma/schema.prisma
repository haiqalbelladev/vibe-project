generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  whatsapp     String?
  passwordHash String?
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles                 UserRole[]
  userOrganizationalUnits   UserOrganizationalUnit[]
  userWarehouseScopes       UserWarehouseScope[]
  purchaseRequests          PurchaseRequest[]
  purchaseRequestApprovals  PurchaseRequestApproval[]
  purchaseRequestItemRoutings PurchaseRequestItemRouting[]
  purchaseOrders PurchaseOrder[]
  cashTransactions CashTransaction[]
  cashTransactionApprovals CashTransactionApproval[]
  cashReportsCreated CashReport[]
  supplierInvoicesCreated SupplierInvoice[]
  paymentRequestsCreated PaymentRequest[]
  paymentRequestApprovals PaymentRequestApproval[]
  paymentsCreated Payment[]
  goodsReceipts GoodsReceipt[]
  goodsIssues GoodsIssue[]
  stockOpnamesCreated StockOpname[]
  stockOpnameApprovals StockOpnameApproval[]
  auditLogs AuditLog[]
  passwordResetTokens PasswordResetToken[]
  supplierEvaluations SupplierEvaluation[]
  supplierFollowUps SupplierFollowUp[]
  documentSignatures         DocumentSignature[]
  notifications Notification[]
  dailySessionsStarted DailyOperationalSession[] @relation("DailySessionStartedBy")
  dailySessionsEnded   DailyOperationalSession[] @relation("DailySessionEndedBy")

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationalUnit {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  parentId String? @db.Uuid

  parent   OrganizationalUnit?  @relation("OrganizationalUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children OrganizationalUnit[] @relation("OrganizationalUnitHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOrganizationalUnits UserOrganizationalUnit[]
  purchaseRequests PurchaseRequest[]
  budgets         Budget[]

  @@index([parentId])
  @@index([isActive])
  @@map("organizational_units")
}

model UserOrganizationalUnit {
  userId               String @db.Uuid
  organizationalUnitId String @db.Uuid

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  assignedAt DateTime @default(now())

  @@id([userId, organizationalUnitId])
  @@index([organizationalUnitId])
  @@map("user_organizational_units")
}

model ItemCategory {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([isActive])
  @@map("item_categories")
}

model UnitOfMeasure {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  purchaseRequestItems PurchaseRequestItem[]

  @@index([isActive])
  @@map("units_of_measure")
}

model Item {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  categoryId String @db.Uuid
  uomId      String @db.Uuid

  category ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uom      UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  aliases ItemAlias[]
  inventories Inventory[]

  purchaseRequestItems PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([uomId])
  @@index([isActive])
  @@map("items")
}

model ItemAlias {
  id String @id @default(uuid()) @db.Uuid

  itemId String @db.Uuid
  alias  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, alias])
  @@index([alias])
  @@index([isActive])
  @@map("item_aliases")
}

model Supplier {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  contactName String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  taxNumber   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankAccounts SupplierBankAccount[]
  evaluations SupplierEvaluation[]
  performancePeriods SupplierPerformancePeriod[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  followUps SupplierFollowUp[]

  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierBankAccount {
  id String @id @default(uuid()) @db.Uuid

  supplierId String @db.Uuid
  bankName   String
  accountNumber String
  accountName   String

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([isActive])
  @@map("supplier_bank_accounts")
}

model SupplierEvaluation {
  id String @id @default(uuid()) @db.Uuid

  supplierId String @db.Uuid
  evaluatorId String @db.Uuid

  evaluationDate DateTime @default(now())
  periodStart   DateTime?
  periodEnd     DateTime?

  responsivenessScore     Int?
  serviceScore            Int?
  communicationScore      Int?
  problemResolutionScore  Int?
  professionalismScore    Int?

  overallScore Decimal? @db.Decimal(5, 2)

  notes String?

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  evaluator User     @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  followUps SupplierFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([evaluatorId])
  @@index([evaluationDate])
  @@index([periodStart, periodEnd])
  @@map("supplier_evaluations")
}

model SupplierFollowUp {
  id String @id @default(uuid()) @db.Uuid

  supplierId String @db.Uuid
  evaluationId String? @db.Uuid

  issue String
  evidence String?
  correctiveAction String
  targetDate DateTime?

  picId String @db.Uuid

  status String
  result String?
  decision String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  evaluation SupplierEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  pic User @relation(fields: [picId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([evaluationId])
  @@index([picId])
  @@index([status])
  @@index([targetDate])
  @@map("supplier_follow_ups")
}

model SupplierPerformancePeriod {
  id String @id @default(uuid()) @db.Uuid

  supplierId String @db.Uuid

  periodStart DateTime
  periodEnd   DateTime

  poCount         Int @default(0)
  grnCount        Int @default(0)
  orderedQuantity Decimal @default(0) @db.Decimal(18, 4)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  rejectedQuantity Decimal @default(0) @db.Decimal(18, 4)

  onTimeRate         Decimal? @db.Decimal(5, 2)
  quantityFulfillmentRate Decimal? @db.Decimal(5, 2)
  qualityRate        Decimal? @db.Decimal(5, 2)

  automaticScore Decimal? @db.Decimal(5, 2)
  manualScore    Decimal? @db.Decimal(5, 2)
  overallScore   Decimal? @db.Decimal(5, 2)

  notes String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, periodStart, periodEnd])
  @@index([supplierId])
  @@index([periodStart, periodEnd])
  @@index([overallScore])
  @@map("supplier_performance_periods")
}

model Warehouse {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  type        String
  description String?

  inventoryManaged Boolean @default(true)
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userWarehouseScopes UserWarehouseScope[]
  inventories Inventory[]
  goodsReceipts GoodsReceipt[]
  goodsIssues GoodsIssue[]
  stockOpnames StockOpname[]

  @@index([type])
  @@index([isActive])
  @@map("warehouses")
}

model UserWarehouseScope {
  userId      String @db.Uuid
  warehouseId String @db.Uuid

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)

  assignedAt DateTime @default(now())

  @@id([userId, warehouseId])
  @@index([warehouseId])
  @@map("user_warehouse_scopes")
}

model StockClassification {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories Inventory[]

  @@index([isActive])
  @@map("stock_classifications")
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid

  itemId               String @db.Uuid
  warehouseId          String @db.Uuid
  stockClassificationId String @db.Uuid

  quantity Decimal @default(0) @db.Decimal(18, 4)

  item               Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse          Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockClassification StockClassification @relation(fields: [stockClassificationId], references: [id], onDelete: Restrict)

  ledgerEntries InventoryLedger[]
  goodsIssueItems GoodsIssueItem[]
  stockOpnameItems StockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, warehouseId, stockClassificationId])
  @@index([warehouseId])
  @@index([stockClassificationId])
  @@map("inventories")
}

model InventoryLedger {
  id String @id @default(uuid()) @db.Uuid

  inventoryId String @db.Uuid
  goodsIssueItemId String? @unique @db.Uuid
  goodsReceiptItemId String? @unique @db.Uuid

  movementType String
  quantity     Decimal @db.Decimal(18, 4)
  quantityAfter Decimal @db.Decimal(18, 4)

  unitCost  Decimal? @db.Decimal(18, 4)
  totalCost Decimal? @db.Decimal(18, 4)

  referenceType String?
  referenceId   String?

  notes String?

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)

  goodsIssueItem GoodsIssueItem? @relation(fields: [goodsIssueItemId], references: [id], onDelete: Restrict)

  stockOpnameItem StockOpnameItem?

  createdAt DateTime @default(now())

  @@index([inventoryId, createdAt])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@map("inventory_ledger")
}

model PurchaseRequest {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  requesterId String @db.Uuid
  organizationalUnitId String @db.Uuid

  purpose             String
  requestedDeliveryAt DateTime?

  status String

  notes String?

  requester User @relation(fields: [requesterId], references: [id], onDelete: Restrict)

  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  items PurchaseRequestItem[]

  goodsIssues GoodsIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([organizationalUnitId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id String @id @default(uuid()) @db.Uuid

  purchaseRequestId String @db.Uuid
  itemId            String @db.Uuid
  uomId             String @db.Uuid

  specification String?
  quantity      Decimal @db.Decimal(18, 4)
  approvedQuantity Decimal? @db.Decimal(18, 4)

  approvalStatus String
  approvalNote   String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  uom UnitOfMeasure @relation(fields: [uomId], references: [id], onDelete: Restrict)

  approvals PurchaseRequestApproval[]

  routing PurchaseRequestItemRouting?

  purchaseOrderItems PurchaseOrderItem[]

  goodsIssueItems GoodsIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseRequestId])
  @@index([itemId])
  @@index([uomId])
  @@index([approvalStatus])
  @@map("purchase_request_items")
}

model PurchaseRequestApproval {
  id String @id @default(uuid()) @db.Uuid

  purchaseRequestItemId String @db.Uuid
  approverId            String @db.Uuid

  decision String
  note     String?

  approvedAt DateTime @default(now())

  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Cascade)

  approver User @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestItemId])
  @@index([approverId])
  @@index([decision])
  @@index([approvedAt])
  @@map("purchase_request_approvals")
}

model PurchaseRequestItemRouting {
  id String @id @default(uuid()) @db.Uuid

  purchaseRequestItemId String @unique @db.Uuid
  routedById            String @db.Uuid

  destinationType String
  notes           String?

  routedAt DateTime @default(now())

  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Cascade)

  routedBy User @relation(fields: [routedById], references: [id], onDelete: Restrict)

  @@index([routedById])
  @@index([destinationType])
  @@index([routedAt])
  @@map("purchase_request_item_routings")
}

model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  supplierId String @db.Uuid
  createdById String @db.Uuid

  orderDate DateTime @default(now())
  status    String

  notes String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  supplierInvoices SupplierInvoicePurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid

  purchaseOrderId       String @db.Uuid
  purchaseRequestItemId String @db.Uuid

  quantity   Decimal @db.Decimal(18, 4)
  unitPrice  Decimal @db.Decimal(18, 4)
  totalPrice Decimal @db.Decimal(18, 4)

  notes String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)

  goodsReceiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([purchaseRequestItemId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  purchaseOrderId String @db.Uuid
  warehouseId     String @db.Uuid
  receivedById    String @db.Uuid

  receiptDate DateTime @default(now())
  status      String

  receivingType String

  notes String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  receivedBy User @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  items GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([receivedById])
  @@index([status])
  @@index([receiptDate])
  @@index([receivingType])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id String @id @default(uuid()) @db.Uuid

  goodsReceiptId    String @db.Uuid
  purchaseOrderItemId String @db.Uuid

  quantityReceived Decimal @db.Decimal(18, 4)
  quantityAccepted Decimal @db.Decimal(18, 4)
  quantityRejected Decimal @db.Decimal(18, 4)

  condition String

  discrepancyReason String?
  damageNote        String?

  notes String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  inventoryLedgerEntry InventoryLedger?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([condition])
  @@map("goods_receipt_items")
}

model GoodsIssue {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  purchaseRequestId String @db.Uuid
  warehouseId       String @db.Uuid
  issuedById        String @db.Uuid

  issueDate DateTime @default(now())
  status    String

  notes String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  issuedBy User @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  items GoodsIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseRequestId])
  @@index([warehouseId])
  @@index([issuedById])
  @@index([status])
  @@index([issueDate])
  @@map("goods_issues")
}

model GoodsIssueItem {
  id String @id @default(uuid()) @db.Uuid

  goodsIssueId         String @db.Uuid
  purchaseRequestItemId String @db.Uuid
  inventoryId          String @db.Uuid

  quantityIssued Decimal @db.Decimal(18, 4)

  goodsIssue GoodsIssue @relation(fields: [goodsIssueId], references: [id], onDelete: Cascade)

  purchaseRequestItem PurchaseRequestItem @relation(fields: [purchaseRequestItemId], references: [id], onDelete: Restrict)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  inventoryLedgerEntry InventoryLedger?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsIssueId])
  @@index([purchaseRequestItemId])
  @@index([inventoryId])
  @@map("goods_issue_items")
}

model StockOpname {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  warehouseId String @db.Uuid
  createdById String @db.Uuid

  opnameDate DateTime @default(now())
  status     String

  notes String?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items StockOpnameItem[]
  approvals StockOpnameApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([createdById])
  @@index([status])
  @@index([opnameDate])
  @@map("stock_opnames")
}

model StockOpnameItem {
  id String @id @default(uuid()) @db.Uuid

  stockOpnameId String @db.Uuid
  inventoryId   String @db.Uuid
  inventoryLedgerEntryId String? @unique @db.Uuid

  systemQuantity   Decimal @db.Decimal(18, 4)
  physicalQuantity Decimal @db.Decimal(18, 4)

  discrepancyReason String?

  notes String?

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  inventoryLedgerEntry InventoryLedger? @relation(fields: [inventoryLedgerEntryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockOpnameId])
  @@index([inventoryId])
  @@unique([stockOpnameId, inventoryId])
  @@map("stock_opname_items")
}

model StockOpnameApproval {
  id String @id @default(uuid()) @db.Uuid

  stockOpnameId String @db.Uuid
  approverId    String @db.Uuid

  action String
  note   String?

  approvedAt DateTime @default(now())

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  approver    User        @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([stockOpnameId])
  @@index([approverId])
  @@index([action])
  @@index([approvedAt])
  @@map("stock_opname_approvals")
}

model Budget {
  id String @id @default(uuid()) @db.Uuid

  number String @unique
  name   String

  organizationalUnitId String @db.Uuid

  budgetYear Int
  amount     Decimal @db.Decimal(18, 2)

  status String
  notes  String?

  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  disbursements BudgetDisbursement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationalUnitId])
  @@index([budgetYear])
  @@index([status])
  @@map("budgets")
}

model BudgetDisbursement {
  id String @id @default(uuid()) @db.Uuid

  number   String   @unique
  budgetId String   @db.Uuid

  disbursementDate DateTime
  amount           Decimal @db.Decimal(18, 2)

  status String
  notes  String?

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  cashTransactions CashTransaction[]
  cashReports CashReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([disbursementDate])
  @@index([status])
  @@map("budget_disbursements")
}

model CashTransaction {
  id String @id @default(uuid()) @db.Uuid

  number String @unique

  budgetDisbursementId String @db.Uuid
  createdById          String @db.Uuid

  cashReportId String? @db.Uuid

  transactionDate DateTime
  supplierName    String?
  description     String

  amount Decimal @db.Decimal(18, 2)

  status String

  receiptNumber String?
  notes         String?

  budgetDisbursement BudgetDisbursement @relation(fields: [budgetDisbursementId], references: [id], onDelete: Restrict)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  cashReport CashReport? @relation(fields: [cashReportId], references: [id], onDelete: SetNull)

  approvals CashTransactionApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetDisbursementId])
  @@index([createdById])
  @@index([transactionDate])
  @@index([status])
  @@map("cash_transactions")
